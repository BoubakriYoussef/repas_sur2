# Copy this file to ".env" and replace all placeholder values.
# Do not commit your real .env file.

POSTGRES_DB=repas_sur
POSTGRES_USER=repas_user
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

SPRING_PROFILES_ACTIVE=prod

# Base64-encoded secret with at least 32 bytes once decoded.
# Example generation (Linux/macOS/Git Bash): openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_BASE64_SECRET
JWT_EXPIRATION_MS=86400000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
