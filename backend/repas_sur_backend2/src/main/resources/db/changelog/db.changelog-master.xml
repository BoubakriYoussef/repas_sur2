        </preConditions>
        <createTable tableName="convive_regime">
            <column name="convive_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="regime_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="014-convive-regime-pk" author="youssefboubakri">
        <preConditions onFail="MARK_RAN">
            <not>
                <primaryKeyExists tableName="convive_regime" primaryKeyName="pk_convive_regime"/>
            </not>
        </preConditions>
        <addPrimaryKey tableName="convive_regime" columnNames="convive_id, regime_id" constraintName="pk_convive_regime"/>
    </changeSet>

    <changeSet id="015-plat-allergene" author="youssefboubakri">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="plat_allergene"/>
            </not>
        </preConditions>
        <createTable tableName="plat_allergene">
            <column name="plat_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="allergene_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

