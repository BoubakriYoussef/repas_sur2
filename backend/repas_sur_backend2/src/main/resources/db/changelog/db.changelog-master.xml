            </column>
            <column name="plat_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="018-menu-plat-pk" author="youssefboubakri">
        <preConditions onFail="MARK_RAN">
            <not>
                <primaryKeyExists tableName="menu_plat" primaryKeyName="pk_menu_plat"/>
            </not>
        </preConditions>
