<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="001-site" author="youssefboubakri">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="site_restauration"/>
            </not>
        </preConditions>
        <createTable tableName="site_restauration">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nom" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="adresse" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="002-regime" author="youssefboubakri">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="regime"/>
            </not>
        </preConditions>
        <createTable tableName="regime">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(100)"/>
            <column name="libelle" type="VARCHAR(255)"/>
            <column name="type" type="VARCHAR(50)"/>
            <column name="description" type="VARCHAR(500)"/>
        </createTable>
    </changeSet>

    <changeSet id="003-allergene" author="youssefboubakri">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="allergene"/>
            </not>
        </preConditions>
        <createTable tableName="allergene">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(100)"/>
            <column name="libelle" type="VARCHAR(255)"/>
            <column name="description" type="VARCHAR(500)"/>
        </createTable>
    </changeSet>

    <changeSet id="004-plat" author="youssefboubakri">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="plat"/>
            </not>
        </preConditions>
        <createTable tableName="plat">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nom" type="VARCHAR(255)"/>
            <column name="categorie" type="VARCHAR(100)"/>
            <column name="description" type="VARCHAR(500)"/>
            <column name="contient_porc" type="BOOLEAN"/>
            <column name="est_vegetarien" type="BOOLEAN"/>
        </createTable>
    </changeSet>

    <changeSet id="005-menu" author="youssefboubakri">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="menu"/>
            </not>
        </preConditions>
        <createTable tableName="menu">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nom" type="VARCHAR(255)"/>
            <column name="description" type="VARCHAR(500)"/>
        </createTable>
    </changeSet>

    <changeSet id="006-convive" author="youssefboubakri">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="convive"/>
            </not>
        </preConditions>
        <createTable tableName="convive">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nom" type="VARCHAR(255)"/>
            <column name="prenom" type="VARCHAR(255)"/>
            <column name="type_convive" type="VARCHAR(50)"/>
            <column name="site_id" type="BIGINT"/>
        </createTable>
    </changeSet>

    <changeSet id="007-utilisateur" author="youssefboubakri">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="utilisateur"/>
            </not>
        </preConditions>
        <createTable tableName="utilisateur">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(150)"/>
            <column name="password" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="telephone" type="VARCHAR(50)"/>
            <column name="poste" type="VARCHAR(100)"/>
            <column name="role" type="VARCHAR(50)"/>
            <column name="actif" type="BOOLEAN"/>
            <column name="site_id" type="BIGINT"/>
        </createTable>
    </changeSet>

    <changeSet id="008-service-repas" author="youssefboubakri">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="service_repas"/>
            </not>
        </preConditions>
        <createTable tableName="service_repas">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="date_service" type="TIMESTAMP"/>
            <column name="type_repas" type="VARCHAR(50)"/>
            <column name="statut" type="VARCHAR(50)"/>
            <column name="site_id" type="BIGINT"/>
            <column name="menu_id" type="BIGINT"/>
        </createTable>
    </changeSet>

    <changeSet id="009-alerte-risque" author="youssefboubakri">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="alerte_risque"/>
            </not>
        </preConditions>
        <createTable tableName="alerte_risque">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="etat" type="VARCHAR(50)"/>
            <column name="niveau" type="VARCHAR(50)"/>
            <column name="message" type="VARCHAR(500)"/>
            <column name="date_creation" type="TIMESTAMP"/>
            <column name="convive_id" type="BIGINT"/>
            <column name="service_id" type="BIGINT"/>
        </createTable>
    </changeSet>

    <changeSet id="010-action-corrective" author="youssefboubakri">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="action_corrective"/>
            </not>
        </preConditions>
        <createTable tableName="action_corrective">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="date" type="TIMESTAMP"/>
            <column name="type_action" type="VARCHAR(100)"/>
            <column name="description" type="VARCHAR(500)"/>
            <column name="alerte_id" type="BIGINT"/>
            <column name="utilisateur_id" type="BIGINT"/>
        </createTable>
    </changeSet>

    <changeSet id="011-convive-allergene" author="youssefboubakri">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="convive_allergene"/>
            </not>
        </preConditions>
        <createTable tableName="convive_allergene">
            <column name="convive_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="allergene_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="012-convive-allergene-pk" author="youssefboubakri">
        <preConditions onFail="MARK_RAN">
            <not>
                <primaryKeyExists tableName="convive_allergene" primaryKeyName="pk_convive_allergene"/>
            </not>
        </preConditions>
        <addPrimaryKey tableName="convive_allergene" columnNames="convive_id, allergene_id" constraintName="pk_convive_allergene"/>
    </changeSet>

    <changeSet id="013-convive-regime" author="youssefboubakri">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="convive_regime"/>
