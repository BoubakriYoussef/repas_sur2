            <column name="allergene_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="020-alerte-allergene-pk" author="youssefboubakri">
        <preConditions onFail="MARK_RAN">
            <not>
                <primaryKeyExists tableName="alerte_allergene" primaryKeyName="pk_alerte_allergene"/>
            </not>
        </preConditions>
        <addPrimaryKey tableName="alerte_allergene" columnNames="alerte_id, allergene_id" constraintName="pk_alerte_allergene"/>
    </changeSet>

    <changeSet id="021-foreign-keys" author="youssefboubakri">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_convive_site"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint baseTableName="convive" baseColumnNames="site_id"
                                 referencedTableName="site_restauration" referencedColumnNames="id"
                                 constraintName="fk_convive_site"/>
        <addForeignKeyConstraint baseTableName="utilisateur" baseColumnNames="site_id"
                                 referencedTableName="site_restauration" referencedColumnNames="id"
                                 constraintName="fk_utilisateur_site"/>
        <addForeignKeyConstraint baseTableName="service_repas" baseColumnNames="site_id"
                                 referencedTableName="site_restauration" referencedColumnNames="id"
                                 constraintName="fk_service_site"/>
        <addForeignKeyConstraint baseTableName="service_repas" baseColumnNames="menu_id"
                                 referencedTableName="menu" referencedColumnNames="id"
                                 constraintName="fk_service_menu"/>
        <addForeignKeyConstraint baseTableName="alerte_risque" baseColumnNames="convive_id"
                                 referencedTableName="convive" referencedColumnNames="id"
                                 constraintName="fk_alerte_convive"/>
        <addForeignKeyConstraint baseTableName="alerte_risque" baseColumnNames="service_id"
                                 referencedTableName="service_repas" referencedColumnNames="id"
                                 constraintName="fk_alerte_service"/>
        <addForeignKeyConstraint baseTableName="action_corrective" baseColumnNames="alerte_id"
                                 referencedTableName="alerte_risque" referencedColumnNames="id"
                                 constraintName="fk_action_alerte"/>
        <addForeignKeyConstraint baseTableName="action_corrective" baseColumnNames="utilisateur_id"
                                 referencedTableName="utilisateur" referencedColumnNames="id"
                                 constraintName="fk_action_utilisateur"/>
        <addForeignKeyConstraint baseTableName="convive_allergene" baseColumnNames="convive_id"
                                 referencedTableName="convive" referencedColumnNames="id"
                                 constraintName="fk_convive_allergene_convive"/>
        <addForeignKeyConstraint baseTableName="convive_allergene" baseColumnNames="allergene_id"
                                 referencedTableName="allergene" referencedColumnNames="id"
                                 constraintName="fk_convive_allergene_allergene"/>
        <addForeignKeyConstraint baseTableName="convive_regime" baseColumnNames="convive_id"
                                 referencedTableName="convive" referencedColumnNames="id"
                                 constraintName="fk_convive_regime_convive"/>
        <addForeignKeyConstraint baseTableName="convive_regime" baseColumnNames="regime_id"
                                 referencedTableName="regime" referencedColumnNames="id"
                                 constraintName="fk_convive_regime_regime"/>
        <addForeignKeyConstraint baseTableName="plat_allergene" baseColumnNames="plat_id"
                                 referencedTableName="plat" referencedColumnNames="id"
                                 constraintName="fk_plat_allergene_plat"/>
        <addForeignKeyConstraint baseTableName="plat_allergene" baseColumnNames="allergene_id"
                                 referencedTableName="allergene" referencedColumnNames="id"
                                 constraintName="fk_plat_allergene_allergene"/>
        <addForeignKeyConstraint baseTableName="menu_plat" baseColumnNames="menu_id"
                                 referencedTableName="menu" referencedColumnNames="id"
                                 constraintName="fk_menu_plat_menu"/>
        <addForeignKeyConstraint baseTableName="menu_plat" baseColumnNames="plat_id"
                                 referencedTableName="plat" referencedColumnNames="id"
                                 constraintName="fk_menu_plat_plat"/>
        <addForeignKeyConstraint baseTableName="alerte_allergene" baseColumnNames="alerte_id"
                                 referencedTableName="alerte_risque" referencedColumnNames="id"
                                 constraintName="fk_alerte_allergene_alerte"/>
        <addForeignKeyConstraint baseTableName="alerte_allergene" baseColumnNames="allergene_id"
                                 referencedTableName="allergene" referencedColumnNames="id"
                                 constraintName="fk_alerte_allergene_allergene"/>
    </changeSet>
</databaseChangeLog>
