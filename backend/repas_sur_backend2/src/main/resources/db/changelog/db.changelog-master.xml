        <preConditions onFail="MARK_RAN">
            <not>
                <primaryKeyExists tableName="plat_allergene" primaryKeyName="pk_plat_allergene"/>
            </not>
        </preConditions>
        <addPrimaryKey tableName="plat_allergene" columnNames="plat_id, allergene_id" constraintName="pk_plat_allergene"/>
    </changeSet>

    <changeSet id="017-menu-plat" author="youssefboubakri">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="menu_plat"/>
            </not>
        </preConditions>
        <createTable tableName="menu_plat">
            <column name="menu_id" type="BIGINT">
