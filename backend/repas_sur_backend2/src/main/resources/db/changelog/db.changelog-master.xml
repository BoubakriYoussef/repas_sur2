<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="001-init" author="youssefboubakri">
        <createTable tableName="site_restauration">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nom" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="adresse" type="VARCHAR(255)"/>
        </createTable>

        <createTable tableName="regime">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(100)"/>
            <column name="libelle" type="VARCHAR(255)"/>
            <column name="type" type="VARCHAR(50)"/>
            <column name="description" type="VARCHAR(500)"/>
        </createTable>

        <createTable tableName="allergene">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(100)"/>
            <column name="libelle" type="VARCHAR(255)"/>
            <column name="description" type="VARCHAR(500)"/>
        </createTable>

        <createTable tableName="plat">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nom" type="VARCHAR(255)"/>
            <column name="categorie" type="VARCHAR(100)"/>
            <column name="description" type="VARCHAR(500)"/>
            <column name="contient_porc" type="BOOLEAN"/>
            <column name="est_vegetarien" type="BOOLEAN"/>
        </createTable>

        <createTable tableName="menu">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nom" type="VARCHAR(255)"/>
            <column name="description" type="VARCHAR(500)"/>
        </createTable>

        <createTable tableName="convive">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nom" type="VARCHAR(255)"/>
            <column name="prenom" type="VARCHAR(255)"/>
            <column name="type_convive" type="VARCHAR(50)"/>
            <column name="site_id" type="BIGINT"/>
        </createTable>

        <createTable tableName="utilisateur">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(150)"/>
            <column name="password" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="telephone" type="VARCHAR(50)"/>
            <column name="poste" type="VARCHAR(100)"/>
            <column name="role" type="VARCHAR(50)"/>
            <column name="actif" type="BOOLEAN"/>
            <column name="site_id" type="BIGINT"/>
        </createTable>

        <createTable tableName="service_repas">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="date_service" type="TIMESTAMP"/>
            <column name="type_repas" type="VARCHAR(50)"/>
            <column name="statut" type="VARCHAR(50)"/>
            <column name="site_id" type="BIGINT"/>
            <column name="menu_id" type="BIGINT"/>
        </createTable>

        <createTable tableName="alerte_risque">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="etat" type="VARCHAR(50)"/>
            <column name="niveau" type="VARCHAR(50)"/>
            <column name="message" type="VARCHAR(500)"/>
            <column name="date_creation" type="TIMESTAMP"/>
            <column name="convive_id" type="BIGINT"/>
            <column name="service_id" type="BIGINT"/>
        </createTable>

        <createTable tableName="action_corrective">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="date" type="TIMESTAMP"/>
            <column name="type_action" type="VARCHAR(100)"/>
            <column name="description" type="VARCHAR(500)"/>
            <column name="alerte_id" type="BIGINT"/>
            <column name="utilisateur_id" type="BIGINT"/>
        </createTable>

        <createTable tableName="convive_allergene">
            <column name="convive_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="allergene_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="convive_allergene" columnNames="convive_id, allergene_id" constraintName="pk_convive_allergene"/>

        <createTable tableName="convive_regime">
            <column name="convive_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="regime_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="convive_regime" columnNames="convive_id, regime_id" constraintName="pk_convive_regime"/>

        <createTable tableName="plat_allergene">
            <column name="plat_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="allergene_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="plat_allergene" columnNames="plat_id, allergene_id" constraintName="pk_plat_allergene"/>

        <createTable tableName="menu_plat">
            <column name="menu_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="plat_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="menu_plat" columnNames="menu_id, plat_id" constraintName="pk_menu_plat"/>

        <createTable tableName="alerte_allergene">
            <column name="alerte_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="allergene_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="alerte_allergene" columnNames="alerte_id, allergene_id" constraintName="pk_alerte_allergene"/>

        <addForeignKeyConstraint baseTableName="convive" baseColumnNames="site_id"
                                 referencedTableName="site_restauration" referencedColumnNames="id"
                                 constraintName="fk_convive_site"/>
        <addForeignKeyConstraint baseTableName="utilisateur" baseColumnNames="site_id"
                                 referencedTableName="site_restauration" referencedColumnNames="id"
                                 constraintName="fk_utilisateur_site"/>
        <addForeignKeyConstraint baseTableName="service_repas" baseColumnNames="site_id"
                                 referencedTableName="site_restauration" referencedColumnNames="id"
                                 constraintName="fk_service_site"/>
        <addForeignKeyConstraint baseTableName="service_repas" baseColumnNames="menu_id"
                                 referencedTableName="menu" referencedColumnNames="id"
                                 constraintName="fk_service_menu"/>
        <addForeignKeyConstraint baseTableName="alerte_risque" baseColumnNames="convive_id"
                                 referencedTableName="convive" referencedColumnNames="id"
                                 constraintName="fk_alerte_convive"/>
        <addForeignKeyConstraint baseTableName="alerte_risque" baseColumnNames="service_id"
                                 referencedTableName="service_repas" referencedColumnNames="id"
                                 constraintName="fk_alerte_service"/>
        <addForeignKeyConstraint baseTableName="action_corrective" baseColumnNames="alerte_id"
                                 referencedTableName="alerte_risque" referencedColumnNames="id"
                                 constraintName="fk_action_alerte"/>
        <addForeignKeyConstraint baseTableName="action_corrective" baseColumnNames="utilisateur_id"
                                 referencedTableName="utilisateur" referencedColumnNames="id"
                                 constraintName="fk_action_utilisateur"/>

        <addForeignKeyConstraint baseTableName="convive_allergene" baseColumnNames="convive_id"
                                 referencedTableName="convive" referencedColumnNames="id"
                                 constraintName="fk_convive_allergene_convive"/>
        <addForeignKeyConstraint baseTableName="convive_allergene" baseColumnNames="allergene_id"
                                 referencedTableName="allergene" referencedColumnNames="id"
                                 constraintName="fk_convive_allergene_allergene"/>

        <addForeignKeyConstraint baseTableName="convive_regime" baseColumnNames="convive_id"
                                 referencedTableName="convive" referencedColumnNames="id"
                                 constraintName="fk_convive_regime_convive"/>
        <addForeignKeyConstraint baseTableName="convive_regime" baseColumnNames="regime_id"
                                 referencedTableName="regime" referencedColumnNames="id"
                                 constraintName="fk_convive_regime_regime"/>

        <addForeignKeyConstraint baseTableName="plat_allergene" baseColumnNames="plat_id"
                                 referencedTableName="plat" referencedColumnNames="id"
                                 constraintName="fk_plat_allergene_plat"/>
        <addForeignKeyConstraint baseTableName="plat_allergene" baseColumnNames="allergene_id"
                                 referencedTableName="allergene" referencedColumnNames="id"
                                 constraintName="fk_plat_allergene_allergene"/>

        <addForeignKeyConstraint baseTableName="menu_plat" baseColumnNames="menu_id"
                                 referencedTableName="menu" referencedColumnNames="id"
                                 constraintName="fk_menu_plat_menu"/>
        <addForeignKeyConstraint baseTableName="menu_plat" baseColumnNames="plat_id"
                                 referencedTableName="plat" referencedColumnNames="id"
                                 constraintName="fk_menu_plat_plat"/>

        <addForeignKeyConstraint baseTableName="alerte_allergene" baseColumnNames="alerte_id"
                                 referencedTableName="alerte_risque" referencedColumnNames="id"
                                 constraintName="fk_alerte_allergene_alerte"/>
        <addForeignKeyConstraint baseTableName="alerte_allergene" baseColumnNames="allergene_id"
                                 referencedTableName="allergene" referencedColumnNames="id"
                                 constraintName="fk_alerte_allergene_allergene"/>
    </changeSet>

</databaseChangeLog>
